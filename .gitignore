# Everything
/*

# Don't ignore config dotfiles
!/.config*
!/.i3

# But Ignore this
/.config/google*
/.config/chromium*
/.config/nwjs*
/.config/Slack
/.config/Insomnia

# Fish related files
fish_history
fish_read_history
fishd.*
.config/fisherman/

# fish: fisher owns conf.d/ functions/ completions/ (all generated, all ignored).
# My config lives in config.fish, fish_plugins, and user/ — tracked.
.config/fish/*
!.config/fish/config.fish
!.config/fish/fish_plugins
!.config/fish/user
!.config/fish/user/**

# Neovim related files
.config/nvim/.netrwhist
